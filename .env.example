# Copy to .env for local dev, or set these in your host's dashboard.

# Planner login password (change this!)
ADMIN_PASSWORD=change-me

# Port to listen on (hosts usually set this automatically)
PORT=3000

# Secret used to sign the login cookie (any long random string)
SESSION_SECRET=please-change-to-a-long-random-string

# Where the SQLite file lives. On a host, point this at a persistent disk.
WEDDING_DB=./wedding.db

# ---- Optional: 2-way Google Sheets sync ----
# The spreadsheet the planner mirrors to / reads back from.
GOOGLE_SHEET_ID=
# The Google service-account key, as a single line of JSON (or use *_FILE).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternatively, a path to the service-account JSON key file.
GOOGLE_SERVICE_ACCOUNT_FILE=
