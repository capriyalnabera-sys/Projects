# Regenerable / live caches stay out; the analyzer's learned state (snapshots,
# calibration, universe lists) is committed so a fresh clone works day one.
data/cache/*
!data/cache/snapshots/
!data/cache/universe/
!data/cache/calibration.json
!data/cache/regime.json
!data/cache/sector_stats.json
!data/cache/fii_dii.json
.cache/

